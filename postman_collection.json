{
  "info": {
    "name": "Tugas API Produk - CRUD Evidence (dengan Test)",
    "description": "15 testcase sesuai urutan skenario pada LAPORAN_EVIDENCE.md. Jalankan `npm run db:seed` dulu agar data kembali ke kondisi awal, nyalakan server dengan `npm start`, lalu kirim request berurutan dari 01 sampai 15. Setiap request memiliki assertion otomatis (status code + isi body) — jalankan lewat Collection Runner untuk melihat hasil PASS/FAIL per testcase.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01. GET semua produk",
      "request": {
        "method": "GET",
        "url": "http://localhost:3000/products"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"01. GET semua produk - status 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"01. GET semua produk - array 2 produk awal\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.length).to.eql(2);",
              "    pm.expect(jsonData[0].name).to.eql('Buku');",
              "});"
            ]
          }
        }
      ],
      "response": []
    },
